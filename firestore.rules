// OurWorld - Firestore Security Rules
// Deploy these in Firebase Console -> Firestore Database -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        // Owner can update their own profile
        request.auth.uid == userId ||
        // Partner can pair an unpaired user with themselves
        (
          resource.data.get('isPaired', false) != true &&
          resource.data.get('paired', false) != true &&
          request.resource.data.partnerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId', 'isPaired', 'paired', 'partnerId'])
        ) ||
        // Paired partner can unpair
        (
          resource.data.partnerId == request.auth.uid &&
          request.resource.data.isPaired == false &&
          request.resource.data.paired == false &&
          request.resource.data.coupleId == "" &&
          request.resource.data.partnerId == "" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId', 'isPaired', 'paired', 'partnerId'])
        )
      );

      // Avatar - only owner can modify their own avatar
      match /avatar/{avatarId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Couple data - only paired partners can read/write
    match /couples/{coupleId} {
      allow read, write: if request.auth != null &&
        (resource == null ||
         resource.data.partner1 == request.auth.uid ||
         resource.data.partner2 == request.auth.uid);

      // Subcollections (furniture, plants, gifts, notes, memories, achievements, milestones)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/couples/$(coupleId)).data.partner1 == request.auth.uid ||
          get(/databases/$(database)/documents/couples/$(coupleId)).data.partner2 == request.auth.uid
        );
      }
    }
  }
}
